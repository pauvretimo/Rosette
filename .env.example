# Copy this file to .env. This is the one canonical config file for the whole project — the
# build (wxt.config.ts) and the self-hosting deployment (docker-compose.yml, both
# generate-*-manifest.mjs scripts) all read this same file, nothing duplicates it elsewhere.
#
# Only actually needed if you're setting up self-hosted auto-updates (see
# self-hosting/README.md). A fresh clone builds fine without this file at all, using a harmless
# placeholder domain.

# Domain the self-hosted Firefox/Chrome update manifests are served from. Baked into each build
# as its `update_url`.
ROSETTE_UPDATES_DOMAIN=updates.example.com

# Name of the external Docker network your existing Traefik container is attached to.
TRAEFIK_NETWORK=traefik

# Name of the Traefik certificate resolver to use for TLS.
TRAEFIK_CERT_RESOLVER=letsencrypt
