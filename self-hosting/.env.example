# Copy this file to .env and fill in real values before `docker compose up`.
# generate-manifest.mjs also reads this file directly, so update_link entries in updates.json
# stay in sync with whatever domain the container actually serves from.

# Domain the update manifest + signed .xpi files are served from.
ROSETTE_UPDATES_DOMAIN=updates.example.com

# Name of the external Docker network your existing Traefik container is attached to.
TRAEFIK_NETWORK=traefik

# Name of the Traefik certificate resolver to use for TLS.
TRAEFIK_CERT_RESOLVER=letsencrypt
